<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Usuario y acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hola, Invitado"
            android:textColor="#00FF00"
            android:textSize="16sp"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <Button
            android:id="@+id/btnEditUser"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:text="Editar"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Salir Sesión"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Mensaje de Firebase - POSICIÓN MEJORADA -->


    <!-- Título del juego -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="60dp"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:letterSpacing="0.1"
        android:text="SNAKE GAME"
        android:textColor="#00FF00"
        android:textSize="42sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="232dp"
        android:layout_height="134dp"
        app:srcCompat="@mipmap/imgsnake" />

    <!-- Contenedor principal de botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="164dp"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Columna izquierda - 2 botones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Botón Jugar -->
            <Button
                android:id="@+id/btnStartGame"
                android:layout_width="180dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:background="@drawable/button_retro_style"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:letterSpacing="0.05"
                android:text="JUGAR"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Botón Puntuaciones -->
            <Button
                android:id="@+id/btnScores"
                android:layout_width="180dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:background="@drawable/button_retro_style"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:letterSpacing="0.05"
                android:text="PUNTUACIONES"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Columna derecha - 2 botones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Botón Configuración -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="180dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:background="@drawable/button_retro_style"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:letterSpacing="0.05"
                android:text="CONFIGURACIÓN"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Botón Tienda -->
            <Button
                android:id="@+id/btnTienda"
                android:layout_width="180dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:background="@drawable/button_retro_style"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:letterSpacing="0.05"
                android:text="TIENDA"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Botón Salir -->
    <LinearLayout
        android:layout_width="362dp"
        android:layout_height="129dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnExit"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:text="Salir"
            android:textColor="#00FF00"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Texto inferior -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:letterSpacing="0.1"
        android:text="©2025 SNAKE ULATINA"
        android:textColor="#666666"
        android:textSize="12sp" />

</LinearLayout>