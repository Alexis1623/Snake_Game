<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

    <!-- Título del juego -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="100dp"
        android:text="SNAKE GAME"
        android:textColor="#00FF00"
        android:textSize="42sp"
        android:textStyle="bold"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:letterSpacing="0.1" />

    <!-- Contenedor HORIZONTAL principal para los botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="60dp"
        android:weightSum="2">

        <!-- Columna izquierda - 2 botones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Botón Jugar -->
            <Button
                android:id="@+id/btnStartGame"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_margin="6dp"
                android:background="@drawable/button_retro_style"
                android:text="JUGAR"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:letterSpacing="0.05" />

            <!-- Botón Puntuaciones -->
            <Button
                android:id="@+id/btnScores"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_margin="6dp"
                android:background="@drawable/button_retro_style"
                android:text="PUNTUACIONES"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Columna derecha - 2 botones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Botón Configuración -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_margin="6dp"
                android:background="@drawable/button_retro_style"
                android:text="CONFIGURACIÓN"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:letterSpacing="0.05" />

            <!-- Botón Salir -->
            <Button
                android:id="@+id/btnExit"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_margin="6dp"
                android:background="@drawable/button_retro_style"
                android:text="SALIR"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </LinearLayout>

    <!-- Texto inferior estilo retro -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="© 2024 SNAKE STUDIOS"
        android:textColor="#666666"
        android:textSize="12sp"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:letterSpacing="0.1" />

</LinearLayout>