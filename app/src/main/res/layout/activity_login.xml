<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐍 SNAKE GAME"
        android:textSize="42sp"
        android:textColor="#00FF00"
        android:textStyle="bold"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:shadowColor="#000000"
        android:shadowRadius="8"
        android:shadowDx="2"
        android:shadowDy="2"
        android:layout_marginBottom="60dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="4dp"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="INGRESA TU USUARIO"
            android:textColorHint="#00AA00"
            android:textColor="#00FF00"
            android:textSize="18sp"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:background="#000000"
            android:padding="20dp"
            android:maxLines="1"
            android:inputType="text" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Máximo 20 caracteres\n• Si no ingresas nombre, serás 'Invitado'"
        android:textSize="14sp"
        android:textColor="#FFFF00"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="▶ JUGAR"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="@drawable/button_retro_style"
        android:textColor="#00FF00"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGuest"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="👤 JUGAR COMO INVITADO"
        android:textSize="18sp"
        android:background="@drawable/button_retro_style"
        android:textColor="#FFFF00"
        android:fontFamily="@font/vcr_osd_mono_1_001" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="©2025 SNAKE ULATINA"
        android:textSize="12sp"
        android:textColor="#888888"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:layout_marginTop="40dp" />

</LinearLayout>
